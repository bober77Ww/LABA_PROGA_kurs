{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\TDM-GCC-64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-I", "C:/Users/ilya_/.vscode_cpp",
                "-include", "console_utf8.h",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-g",
                "-std=c++17",
                "-Wall",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}